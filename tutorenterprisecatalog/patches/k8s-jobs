---
apiVersion: batch/v1
kind: Job
metadata:
  name: enterprise-catalog-job
  labels:
    app.kubernetes.io/component: job
spec:
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: enterprise-catalog
          image: {{ ENTERPRISE_CATALOG_DOCKER_IMAGE }}
          volumeMounts:
            - mountPath: /openedx/enterprise-catalog/enterprise_catalog/settings/tutor/
              name: settings
      volumes:
        - name: settings
          configMap:
            name: enterprise-catalog-settings
